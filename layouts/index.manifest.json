{
  "name": "{{ .Site.Title }}",
  "short_name": "{{ site.Params.label.text | default .Site.Title }}",
  "start_url": "{{ .Site.BaseURL }}",
  "display": "standalone",
  "background_color": "{{ site.Params.assets.manifest_background_color | default `#faf8f5` }}",
  "theme_color": "{{ site.Params.assets.theme_color | default `#3d5a80` }}",
  "icons": [
    {
      "src": "{{ (site.Params.assets.manifest_icon_192 | default `/icon-192.png`) | relURL }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ (site.Params.assets.manifest_icon_512 | default `/icon-512.png`) | relURL }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ (site.Params.assets.manifest_icon_maskable | default `/icon-maskable-512.png`) | relURL }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
