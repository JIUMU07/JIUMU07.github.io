// 发布任务快捷键: Alt+B
// Ctrl+Shift+B 被输入法表情面板占用; Ctrl+Alt+B 被 AI 聊天扩展占用
[
    {
        "key": "alt+b",
        "command": "workbench.action.tasks.runTask",
        "args": {
            "task": "🚀 一键发布到服务器（约10秒）"
        }
    },
    {
        "key": "ctrl+shift+b",
        "command": "-workbench.action.tasks.runTask",
        "args": {
            "task": "🚀 一键发布到服务器（约10秒）"
        }
    }
]