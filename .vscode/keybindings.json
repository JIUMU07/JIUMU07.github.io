// 发布任务快捷键: Alt+B (若被占用可改下面的 key)
[
    {
        "key": "alt+b",
        "command": "workbench.action.tasks.runTask",
        "args": {
            "task": "一键发布到服务器(10秒上线)"
        }
    },
    {
        "key": "ctrl+shift+b",
        "command": "-workbench.action.tasks.runTask",
        "args": {
            "task": "一键发布到服务器(10秒上线)"
        }
    }
]